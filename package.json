{
  "name": "city4rpv-toolchains",
  "version": "0.1.0",
  "private": true,
  "description": "Composable City4RPV data-processing toolchains.",
  "workspaces": [
    "toolchains/tiles-to-mesh/node"
  ],
  "scripts": {
    "tiles-to-mesh:build": "npm run build --workspace @city4rpv/tiles-to-mesh",
    "tiles-to-mesh:run": "npm run run --workspace @city4rpv/tiles-to-mesh",
    "tiles-to-mesh:test": "npm run test --workspace @city4rpv/tiles-to-mesh",
    "tiles-to-mesh:test:integration": "npm run test:integration --workspace @city4rpv/tiles-to-mesh",
    "tiles-to-mesh:python:sync": "uv sync --project toolchains/tiles-to-mesh/python",
    "mesh-to-images:run": "python toolchains/mesh-to-images/main.py",
    "mesh-to-images:test": "python -m unittest discover -s toolchains/mesh-to-images/tests",
    "images-to-vlm:run": "python toolchains/images-to-vlm/main.py",
    "images-to-vlm:test": "python -m unittest discover -s toolchains/images-to-vlm/tests",
    "roof-classification:run": "python workflows/roof-classification/main.py",
    "extract": "npm run tiles-to-mesh:run",
    "test": "npm run tiles-to-mesh:test && npm run mesh-to-images:test && npm run images-to-vlm:test"
  }
}
